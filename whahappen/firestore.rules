rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helpers globales (NUEVO) ===
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    // =========================
    // USERS (perfil + elección)
    // =========================
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /choices/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // =========================
    // CHALLENGES (solo lectura)
    // =========================
    match /challenges/{dateKey} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // SUBMISSIONS (posts)
    // =========================
    match /submissions/{sid} {
      allow read: if true;

      // Crear: el autor debe coincidir con el uid autenticado
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // Autor: solo puede cambiar estos campos (likes/comments/caption)
      function isAuthorSafeUpdate() {
        return request.auth != null
          && request.auth.uid == resource.data.uid
          && request.resource.data.diff(resource.data)
               .changedKeys().hasOnly(['likesCount','commentsCount','caption']);
      }

      // --- VIEWS (con transforms) ---
      // Permitimos actualizaciones SOLO de estos campos:
      // - Autor: puede tocar solo viewsCount
      // - No autor: puede tocar solo viewsFromOthersCount
      // - (opcional) si tu cliente a veces manda ambos, habilita el tercer branch
      function isViewsUpdateWithTransforms() {
        return request.auth != null && (
          (
            // autor -> solo viewsCount
            request.auth.uid == resource.data.uid &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['viewsCount'])
          ) ||
          (
            // no autor -> solo viewsFromOthersCount
            request.auth.uid != resource.data.uid &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['viewsFromOthersCount'])
          ) ||
          (
            // si alguna ruta manda ambos en el mismo commit, habilita este branch
            request.auth.uid != resource.data.uid &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['viewsCount','viewsFromOthersCount'])
          )
        );
      }

      allow update: if isAuthorSafeUpdate() || isViewsUpdateWithTransforms();

      // Borrado deshabilitado
      allow delete: if false;

      // ---- Subcolección: likes ----
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      // ---- Subcolección: comments ----
      match /comments/{cid} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
        allow update: if false;
      }

      // ---- Subcolección: views ----
      // Tu cliente usa transform (REQUEST_TIME) y puede mandar "update".
      // Permitimos create O update SI y solo SI el doc pertenece al viewer
      // y solo escribe 'uid' y 'createdAt'.
      match /views/{viewerUid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == viewerUid
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }
    }

    // =========================
    // FOLLOWS (nivel top)
    // =========================
    match /follows/{fid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.following is string;
      allow delete: if request.auth != null
        && resource.data.follower == request.auth.uid;
      allow update: if false;
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{uid}/items/{notifId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // =========================
    // CHATS
    // =========================
    match /chats/{threadId} {
      allow create: if request.auth != null
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] is string
        && request.resource.data.users[1] is string
        && request.auth.uid in request.resource.data.users;

      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.users;

      allow delete: if false;

      match /messages/{msgId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.users;
        allow update, delete: if false;
      }
    }

    // =========================
    // LEADERBOARDS (solo lectura)
    // =========================
    match /leaderboardDaily/{dateKey} {
      allow read: if true;
      allow write: if false;
    }
    match /trendingDaily/{dateKey} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboard/daily/{dateKey} { // compat
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // SQUAD DAYS (solo Functions escriben)
    // =========================
    match /squadDays/{id} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // SQUADS (cliente puede crear/editar name/members; racha solo Functions)
    // =========================
    match /squads/{squadId} {
      allow read: if true;

      function isMember() {
        return request.auth != null && resource.data.members is list && request.auth.uid in resource.data.members;
      }

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && !(request.resource.data.keys().hasAny(['streak','lastActiveDateKey','streakUpdatedAt']));

      function clientSafeUpdate() {
        return isMember()
          && request.resource.data.streak == resource.data.streak
          && request.resource.data.lastActiveDateKey == resource.data.lastActiveDateKey
          && request.resource.data.streakUpdatedAt == resource.data.streakUpdatedAt
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','members']);
      }
      allow update: if clientSafeUpdate();

      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // =========================
    // LEADERBOARDS (colección plana mensual)
    // =========================
    match /leaderboards_month/{monthId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // SHORTLINKS (opcional lectura pública)
    // =========================
    match /shortlinks/{code} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // LEADERBOARDS (path anidado antiguo - sólo lectura)
    // =========================
    match /leaderboards/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // CREATOR FUND (NUEVO)
    // =========================

    // Estado vivo e histórico (lectura pública)
    match /public/creatorFund/state/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /public/creatorFund/history/{yyyymm} {
      allow read: if true;
      allow write: if false;
    }

    // Wallets (solo dueño lee)
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Payouts mensuales (solo dueño lee)
    match /payouts/monthly/{yyyymm}/byUser/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Métricas mensuales (solo dueño lee)
    match /metrics/monthly/{yyyymm}/creatorPoints/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Withdrawals: crear propio; leer propio o admin; actualizar solo admin
    match /withdrawals/{wid} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountMXN is number
        && request.resource.data.amountMXN >= 300
        && request.resource.data.clabe is string
        && request.resource.data.rfc is string
        && request.resource.data.email is string;
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Config y Revenue: solo admin
    match /config/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /revenue/{doc=**} {
      allow read, write: if isAdmin();
    }
  }
}
